{
  "name": "Trajeto · Águas Lindas",
  "short_name": "Trajeto",
  "description": "Serviços públicos, contatos, locais e rotas de Águas Lindas de Goiás, com atalhos salvos e catálogo disponível offline após a preparação.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B1014",
  "theme_color": "#0B1014",
  "categories": [
    "navigation",
    "travel",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
