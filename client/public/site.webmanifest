      "id": "servicos-publicos",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Canais de emergência",
      "short_name": "Emergência",
      "description": "Abrir os contatos de Polícia, SAMU e Bombeiros",
      "url": "./servicos?emergencia=1#emergency-strip-title",
      "id": "emergencia",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Retomar última rota",
      "short_name": "Retomar",
      "description": "Abrir rapidamente o planejador e continuar a última viagem salva",
      "url": "./planejar",
      "id": "retomar-rota",
      "icons": [
        {
          "src": "./icon-192.png",
