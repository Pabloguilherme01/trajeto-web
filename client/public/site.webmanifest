{
  "name": "Trajeto · Rotas e Postos",
  "short_name": "Trajeto",
  "description": "Planeje rotas, encontre postos e continue consultando mesmo sem internet.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B1014",
  "theme_color": "#0B1014",
  "categories": ["navigation", "travel"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Retomar última rota",
      "short_name": "Retomar",
      "description": "Abrir rapidamente o planejador e continuar a última viagem salva",
      "url": "./planejar",
      "id": "retomar-rota",
      "icons": [{ "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Encontrar postos",
      "short_name": "Postos",
      "description": "Abrir a busca de postos",
      "url": "./postos",
      "id": "postos",
      "icons": [{ "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Perto de mim",
      "short_name": "Perto",
      "description": "Abrir rapidamente a busca de postos próximos",
      "url": "./postos?q=postos%20pr%C3%B3ximos",
      "id": "perto",
      "icons": [{ "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Salvos no aparelho",
      "short_name": "Salvos",
      "description": "Abrir locais e recursos salvos neste dispositivo",
      "url": "./planejar?salvos=1",
      "id": "salvos",
      "icons": [{ "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
