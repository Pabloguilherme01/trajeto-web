# Static public core (GitHub Pages)
# No secret or commercial key is required for the essential public experience.
# Set this explicitly when building for a static host if runtime detection is not enough.
VITE_STATIC_RUNTIME=

# Optional public providers
# Leave blank to use the public defaults/fallbacks implemented by the app.
VITE_PUBLIC_GEOCODER_URL=
VITE_PUBLIC_ROUTING_URL=
VITE_PUBLIC_TILE_URL=

# Optional backend
# Only configure these variables when deploying the Express/tRPC backend.
PORT=3000
NODE_ENV=development
JWT_SECRET=
DATABASE_URL=
VITE_API_BASE_URL=
VITE_ROUTING_API_BASE_URL=
FRONTEND_ORIGIN=

# Optional OAuth / authenticated features
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# Optional commercial/proxy integrations
# These must never become mandatory for the GitHub Pages core.
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# Optional Mapbox online enhancement
# Public client token only; keep URL-restricted and leave blank for the zero-cost core.
VITE_MAPBOX_PUBLIC_TOKEN=

# Optional traffic enrichment
TOMTOM_API_KEY=
TOMTOM_TRAFFIC_ENABLED=

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
